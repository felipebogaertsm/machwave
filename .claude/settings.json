{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make install-dev)",
      "Bash(make install-dev-core)",
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make test-core)",
      "Bash(make coverage)",
      "Bash(make benchmark)",
      "Bash(make docs)",
      "Bash(make docs-deploy)",
      "Bash(uv run pytest *)",
      "Bash(uv run --all-extras pytest *)",
      "Bash(uv run --all-extras python examples/*)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Edit(machwave/_version.py)",
      "Write(machwave/_version.py)",
      "Edit(uv.lock)",
      "Write(uv.lock)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python_file.py\""
          }
        ]
      }
    ]
  }
}
